{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "api/index.js",
      "buildCommand": "prisma migrate deploy"
    },
    "web-buyer": {
      "root": "web-buyer",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "web-seller": {
      "root": "web-seller",
      "framework": "vite",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/(.*)", "destination": "/seller/index.html" }]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/seller", "destination": { "service": "web-seller" } },
    { "source": "/seller/(.*)", "destination": { "service": "web-seller" } },
    { "source": "/(.*)", "destination": { "service": "web-buyer" } }
  ]
}
