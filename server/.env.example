# ─── 서버 ───
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─── DB (지금: SQLite / 나중: postgresql://user:pw@rds-endpoint:5432/apple) ───
DATABASE_URL="file:./dev.db"

# ─── 인증 ───
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# true 면 카카오 검증 없이 목(mock) 로그인 허용 (로컬 개발용)
ALLOW_DEV_LOGIN=true

# ─── 카카오 로그인 ───
# 프론트가 Kakao.Auth.authorize() 로 받아온 인가 코드(code)를
# https://kauth.kakao.com/oauth/token 에서 access_token 으로 교환할 때 client_id 로 사용
# (카카오 개발자 콘솔 > 앱 설정 > 앱 키 > REST API 키)
KAKAO_REST_API_KEY=
# 콘솔에서 "Client Secret" 을 활성화(ON) 해뒀다면 여기도 채워야 토큰 교환이 성공함. 비활성화면 비워둬도 됨.
KAKAO_CLIENT_SECRET=

# ─── TMAP (무료 할당량 주의! 서버에서만 호출 + 캐시 + 일일 상한) ───
TMAP_APP_KEY=
TMAP_DAILY_LIMIT=500

# ─── Firebase (FCM) ───
# 미설정 시 알림은 DB 에만 기록되고 콘솔로 출력됩니다.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── 로그 ───
# error | warn | info | debug   (logs/app.log 에도 함께 기록됩니다)
LOG_LEVEL=info
LOG_DIR=logs
